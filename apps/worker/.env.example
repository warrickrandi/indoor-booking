# ─── Runtime ──────────────────────────────────────────────────────────────────
# Environment name: development | production | test
NODE_ENV=

# ─── Database & Cache ────────────────────────────────────────────────────────
# PostgreSQL connection string (same database as apps/api)
DATABASE_URL=

# Redis connection string (BullMQ job queues, shared with apps/api)
REDIS_URL=

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256 key for decrypting payment gateway credentials — must match apps/api's
# ENCRYPTION_KEY exactly (64 hex chars / 32 bytes)
ENCRYPTION_KEY=

# ─── SMTP (Postal server) ───────────────────────────────────────────────────
SMTP_HOST=
# Default 587
SMTP_PORT=
# Must be a valid email address, e.g. noreply@yourplatform.com
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ─── Absolute URLs (used for links in transactional emails) ─────────────────
FRONTEND_URL=

# ─── Vercel Platforms API (optional — required for the domain-ssl-check job to
# detect when a custom domain's SSL certificate is provisioned) ───────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
