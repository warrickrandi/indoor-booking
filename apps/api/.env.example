# ─── Runtime ──────────────────────────────────────────────────────────────────
# Environment name: development | production | test
NODE_ENV=

# Port the Fastify server listens on (default 3001)
PORT=

# Host the Fastify server binds to (default 0.0.0.0)
HOST=

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com)
ALLOWED_ORIGINS=

# ─── Database & Cache ────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=

# Redis connection string (used for rate limiting, slot locks, BullMQ queues)
REDIS_URL=

# ─── JWT Secrets (generate each with: openssl rand -hex 32) ─────────────────
# Signs venue_staff tokens (15min expiry)
VENUE_JWT_SECRET=

# Signs player tokens (24hr expiry)
PLAYER_JWT_SECRET=

# Signs platform_admin tokens (15min expiry)
PLATFORM_JWT_SECRET=

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256 key for encrypting payment gateway credentials at rest — must be exactly 64 hex chars (32 bytes)
ENCRYPTION_KEY=

# ─── PayHere (platform master credentials, used as fallback when a venue has no gateway config) ─
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=

# ─── SMTP (Postal server) ───────────────────────────────────────────────────
SMTP_HOST=
# Default 587
SMTP_PORT=
# Must be a valid email address, e.g. noreply@yourplatform.com
SMTP_FROM=

# ─── File Storage (Cloudflare R2 / S3-compatible) ────────────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ─── Absolute URLs (used for PayHere redirects/webhooks and email links) ─────
FRONTEND_URL=
API_URL=

# ─── Subdomain & Custom Domain Provisioning ──────────────────────────────────
# Base domain venue subdomains are provisioned under (e.g. {slug}.yourplatform.com)
PLATFORM_DOMAIN=

# Vercel Platforms API token + project ID (optional — required for Elite custom
# domain registration and SSL automation)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
