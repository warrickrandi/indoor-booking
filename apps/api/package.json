{
  "name": "@sports-booking/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":        "tsx watch src/server.ts",
    "build":      "prisma generate --schema=../../packages/db/prisma/schema.prisma && tsc -p tsconfig.json",
    "start":      "node dist/server.js",
    "lint":       "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sports-booking/db":    "workspace:*",
    "@sports-booking/types": "workspace:*",
    "@sports-booking/email": "workspace:*",
    "@aws-sdk/client-s3":    "^3.700.0",
    "@fastify/cors":         "^10.0.1",
    "@fastify/formbody":     "^8.0.2",
    "@fastify/helmet":       "^13.0.0",
    "@fastify/multipart":    "^9.0.1",
    "@fastify/rate-limit":   "^10.1.1",
    "fastify":               "^5.2.1",
    "bcryptjs":              "^2.4.3",
    "bullmq":                "^5.34.8",
    "ioredis":               "^5.4.1",
    "jsonwebtoken":          "^9.0.2",
    "zod":                   "^3.24.1",
    "zod-to-json-schema":    "^3.24.1",
    "dotenv":                "^16.4.7"
  },
  "devDependencies": {
    "@types/bcryptjs":     "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node":         "^22.10.7",
    "tsx":                 "^4.19.2",
    "typescript":          "^5.7.2"
  }
}
