# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/indoor_booking"

# ─── Cache / Queues ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Secrets (generate with: openssl rand -hex 32) ───────────────────────
VENUE_JWT_SECRET="replace_with_32_byte_hex_string"
PLAYER_JWT_SECRET="replace_with_32_byte_hex_string"
PLATFORM_JWT_SECRET="replace_with_32_byte_hex_string"

# ─── Encryption (AES-256, must be exactly 64 hex chars = 32 bytes) ───────────
ENCRYPTION_KEY="replace_with_64_char_hex_string"

# ─── PayHere (platform master credentials) ───────────────────────────────────
PAYHERE_MERCHANT_ID="replace_me"
PAYHERE_SECRET="replace_me"

# ─── SMTP (Postal) ───────────────────────────────────────────────────────────
SMTP_HOST="mail.yourplatform.com"
SMTP_PORT="587"
SMTP_FROM="noreply@yourplatform.com"  # must be a valid email address
SMTP_USER="replace_me"
SMTP_PASSWORD="replace_me"

# ─── File Storage (Cloudflare R2 / S3-compatible) ────────────────────────────
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="replace_me"
STORAGE_SECRET_KEY="replace_me"
STORAGE_BUCKET="indoor-booking"

# ─── API Server ───────────────────────────────────────────────────────────────
PORT="3001"
HOST="0.0.0.0"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── Web App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── Absolute URLs (PayHere redirects/webhooks) ───────────────────────────────
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ─── Subdomain & Custom Domain Provisioning ──────────────────────────────────
# Base domain venue subdomains are provisioned under (e.g. {slug}.yourplatform.com)
PLATFORM_DOMAIN="yourplatform.com"
NEXT_PUBLIC_PLATFORM_DOMAIN="yourplatform.com"

# Vercel Platforms API (optional — required for Elite custom domain + SSL automation)
VERCEL_TOKEN="replace_me"
VERCEL_PROJECT_ID="replace_me"
