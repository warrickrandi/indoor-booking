# Reference values for the local services started by `docker-compose up`.
# These match docker-compose.yml and the DATABASE_URL/REDIS_URL placeholders
# in .env.example — copy them into your root .env when developing against
# the dockerized Postgres/Redis containers.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=indoor_booking
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:password@localhost:5432/indoor_booking"

REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
